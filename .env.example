# Neon Postgres connection string (required for production Postgres persistence)
# Example: postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Khalti ePayment API v2 (Sandbox merchant portal: https://test-admin.khalti.com)
# Leave blank to use the built-in interactive Khalti Sandbox Simulator
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# Public base URL for Khalti return_url callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API key for NOVA AI Assistant (/agent)
GEMINI_API_KEY=

